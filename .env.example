# Firebase WEB app configuration (Firebase console > Project settings > Your apps).
# Copy to .env.local, or pull Development settings from Vercel.
# VITE_* values are included in the browser bundle. Never put private keys here.

# Required for the existing Firebase database and Google sign-in:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional SDK fields; keep existing values when moving an existing project:
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
